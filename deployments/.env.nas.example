# 至少配置一个直播间；变量名末尾是直播间号。
BILIBILI_ROOM_NAME_298626=NateScarlet
# BILIBILI_ROOM_NAME_21449083=物述有栖

# 长连接负责实时事件，轮询负责断线兜底。建议不要低于 30 秒。
BILIBILI_POLLING_INTERVAL_SECS=60
# 连续确认两次才认定状态变化，减少接口瞬时异常误报。
BILIBILI_POLLING_CONFIRMATIONS=2
# 第一次启动时如果房间已经在直播，是否发送开播通知。
BILIBILI_NOTIFY_ON_INITIAL_LIVE=false

# 默认只通过 Apprise 发送开播和下播通知。
APPRISE_EVENTS=LIVE,PREPARING

# 企业微信群机器人：将 KEY 替换为 webhook URL 中 key= 后面的值。
APPRISE_URL_1=wecombot://YOUR_WECOM_BOT_KEY

# 可选：邮件。用户名、授权码和收件地址中的特殊字符必须 URL 编码。
# QQ 邮箱通常使用 SMTP 授权码，不是登录密码。
# APPRISE_URL_2=mailtos://QQ号:SMTP授权码@qq.com/收件人@qq.com

# 也可使用 JSON 数组一次配置多个目标；与 APPRISE_URL_1 等可并存。
# APPRISE_URLS=["wecombot://KEY", "mailtos://user:password@example.com/target@example.com"]

# 可选：覆盖通知文案，支持与 Webhook 相同的 Jinja2 变量。
# APPRISE_TITLE_LIVE=[开播] {{ room.name }}
# APPRISE_BODY_LIVE={{ room.name }} 开播了：{{ room.title }}\n{{ room.url }}
# APPRISE_TITLE_PREPARING=[下播] {{ room.name }}
# APPRISE_BODY_PREPARING={{ room.name }} 已下播\n{{ room.url }}

# 兼容上游的原生开播邮件；如果已通过 Apprise 发邮件，建议不要再开启，以免重复。
# EMAIL_HOST=smtp.qq.com
# EMAIL_PORT=465
# EMAIL_USER=
# EMAIL_PASSWORD=
# EMAIL_TO=
